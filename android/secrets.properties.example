# Copy to secrets.properties (gitignored) and fill in.
# Android Maps SDK key — for map DISPLAY only. Restrict it in Google Cloud Console to
# this app's package (mx.gasappmx) + SHA-1, and enable only "Maps SDK for Android".
# This key is safe to ship in the APK when restricted. The PAID server key for
# Places/Directions is NOT here — it lives in Cloud Functions Secret Manager.
GOOGLE_MAPS_API_KEY=PASTE_ANDROID_MAPS_SDK_KEY_HERE
